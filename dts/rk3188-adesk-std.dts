/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3188.dtsi"

/ {
	model = "aDesk-STD-200H-s RK3188 TV Box";
	compatible = "rockchip,rk3188";

	aliases {
		/* 物理 TTL 接 UART2（0x20064000）；uart2 由 dtsi 默认 alias serial2 映射为 ttyS2 */
		serial0 = &uart0;
		serial2 = &uart2;
		mmc0 = &mmc0;   /* SD 卡控制器 */
		mmc1 = &emmc;   /* eMMC 控制器 */
	};

	chosen {
		/* 修正：console/stdout 对齐物理串口 UART2（ttyS2）；原 serial0/uart0 是误改
		 *
		 * 【第五轮 DTS 改动 2/2：bootargs 与 parameter.txt 的 CMDLINE 完全对齐】
		 * 原代码：
		 *   bootargs = "console=ttyS2,115200 earlyprintk loglevel=8";
		 * 只带 console，没有 root= / blkdevparts。
		 *
		 * 为什么要在 DT 里也写一份？
		 *   内核配置里有 CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y，
		 *   正常路径是 loader 把 parameter.txt 的 CMDLINE 通过 ATAG 传进来并覆盖
		 *   这里的 bootargs（所以上一轮日志里的 CMDLINE 一直等于 parameter 内容）。
		 *   但一旦 loader 没传 ATAG（换 loader / 换刷机模式 / parameter 没被选中），
		 *   内核就会退回到吃这里的 bootargs —— 没有 root= 和 blkdevparts 时
		 *   又必然 panic。这里写同一份完整串，等于给内核留一条备用路径。
		 *   两处内容必须一字不差地保持同步（build.yml 已从 parameter.txt 里读取
		 *   CMDLINE 直接写进 boot.img 头，CI 还会比对，防止两边漂移）。
		 *
		 * blkdevparts=mmcblk1:-@20M(rootfs)：
		 *   eMMC 上没有 MBR/GPT（上一轮日志 unknown-block(179,1) 已证明），
		 *   由内核 block/partitions/cmdline.c 按命令行建分区：
		 *   在 mmcblk1 上、从 20MiB 起、到盘尾，建 1 个名为 rootfs 的分区，
		 *   即 /dev/mmcblk1p1。生效前提是 CONFIG_PARTITION_ADVANCED=y +
		 *   CONFIG_CMDLINE_PARTITION=y（build.yml 编译期已强制校验）。
		 *   注意 "-" 是“剩余全部”，单位字节；20M 与 mtdparts 里 rootfs 的
		 *   0xA000 扇区（×512=20MiB）严格对应，不能改一个不改另一个。
		 */
		stdout-path = "serial2:115200n8";
		// 【第七轮改动：bootargs 补 initrd=0x62000000,0x00800000，与 parameter.txt 的 CMDLINE 逐字对齐】
		// 原因：ttl-rz7 里 boot.img 头带了 ramdisk（头校验 ramdisk_addr=0x62000000、
		// ramdisk_size>0），但内核完全没有 unpack initramfs 的动作，直接进 mount_root
		// 然后 panic —— 说明 loader 没把 ramdisk 交给内核。原厂 parameter-bibl.txt 的
		// CMDLINE 里正是有 initrd=0x62000000,0x00800000，它是 RK31 loader "把 ramdisk
		// 搬到 0x62000000" 的指令。loader 会用自己的 CMDLINE 覆盖这里（ATAG_FROM_
		// BOOTLOADER），所以两边必须同步；平时以 parameter.txt 为准。
		// 原值（保留备查）：
		// bootargs = "console=ttyS2,115200 earlyprintk root=/dev/mmcblk1p1 rootfstype=ext4 rw rootwait init=/sbin/init maxcpus=1 blkdevparts=mmcblk1:-@20M(rootfs)";
		bootargs = "console=ttyS2,115200 earlyprintk root=/dev/mmcblk1p1 rootfstype=ext4 rw rootwait init=/sbin/init initrd=0x62000000,0x00800000 maxcpus=1 blkdevparts=mmcblk1:-@20M(rootfs)";
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x40000000>; /* 1GB DDR3 */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		ion1: ion@88400000 { reg = <0x88400000 0x06400000>; no-map; };
		ion2: ion@7ee00000 { reg = <0x7ee00000 0x09600000>; no-map; };
		fb: framebuffer@7a600000 { reg = <0x7a600000 0x04800000>; no-map; };
	};

	vcc_sys: vsys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vsys";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
	};

	vcc_io: vcc-io-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		key-power {
			gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			label = "GPIO Key Power";
			linux,input-type = <1>;
			wakeup-source;
			debounce-interval = <100>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		led-blue {
			label = "adesk:blue:status";
			gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		led-red {
			label = "adesk:red:power";
			gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	ir_recv: ir-receiver {
		compatible = "gpio-ir-receiver";
		gpios = <&gpio0 RK_PB2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&ir_recv_pin>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "RK_ES8316";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,cpu { sound-dai = <&i2s0>; };
		simple-audio-card,codec { sound-dai = <&es8316>; };
	};
};

&cpu0 { cpu-supply = <&vdd_cpu>; };
&cpu1 { cpu-supply = <&vdd_cpu>; };
&cpu2 { cpu-supply = <&vdd_cpu>; };
&cpu3 { cpu-supply = <&vdd_cpu>; };

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	rk808: pmic@1b {
		compatible = "rockchip,rk808";
		reg = <0x1b>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <1>;
		clock-output-names = "rk808-clkout1", "rk808-clkout2";

		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc6-supply = <&vcc_sys>;
		vcc7-supply = <&vcc_sys>;
		vcc8-supply = <&vcc_io>;
		vcc9-supply = <&vcc_io>;

		regulators {
			vdd_cpu: DCDC_REG1 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1100000>; regulator-max-microvolt = <1100000>; regulator-name = "vdd_arm"; };
			vdd_core: DCDC_REG2 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1100000>; regulator-max-microvolt = <1100000>; regulator-name = "vdd_core"; };
			vcc_ddr: DCDC_REG3 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; regulator-name = "vcc_ddr"; };
			vcc_io_rk: DCDC_REG4 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-name = "vcc_io"; };
			vcc_33: LDO_REG1 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-name = "vcc_33"; };
			vcc_18: LDO_REG2 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-name = "vcc_18"; };
			vcc_10: LDO_REG3 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1000000>; regulator-max-microvolt = <1000000>; regulator-name = "vcc_10"; };
			vcc_18_2: LDO_REG4 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-name = "vcc_18_2"; };
			vcc_28: LDO_REG5 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <2800000>; regulator-max-microvolt = <2800000>; regulator-name = "vcc_28"; };
			vcc_12: LDO_REG6 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; regulator-name = "vcc_12"; };
			vcc_18_3: LDO_REG7 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-name = "vcc_18_3"; };
			vcc_33_2: LDO_REG8 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-name = "vcc_33_2"; };
		};
	};

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB5 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int>;
		#clock-cells = <0>;
		clock-output-names = "xin32k";
		wakeup-source;
	};
};

/* eMMC 控制器 */
&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk>, <&emmc_cmd>, <&emmc_rst>;
	vmmc-supply = <&vcc_io>;
	status = "okay";
};

/* SD 卡槽控制器 (已由 &sdmmc 修正为 &mmc0) */
&mmc0 {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sd0_clk>, <&sd0_cmd>, <&sd0_cd>, <&sd0_bus4>;
	vmmc-supply = <&vcc_io>;
	status = "okay";
};

&emac {
	phy-handle = <&phy0>;
	pinctrl-names = "default";
	pinctrl-0 = <&emac_xfer>, <&emac_mdio>;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy0: ethernet-phy@0 { reg = <0>; };
	};
};

&usbphy { status = "okay"; };
&usb_host { status = "okay"; };
&usb_otg { status = "okay"; };

&i2c4 {
	status = "okay";
	clock-frequency = <100000>;
	es8316: codec@10 {
		compatible = "everest,es8316";
		reg = <0x10>;
		clocks = <&cru SCLK_I2S0>;
		clock-names = "mclk";
		#sound-dai-cells = <0>;
	};
};

&i2s0 { status = "okay"; };

&i2c0 {
	status = "okay";
	vga_edid: eeprom@50 { compatible = "atmel,24c02"; reg = <0x50>; pagesize = <16>; };
};

&i2c2 {
	status = "okay";
	hdmi_tx: hdmi@2b { compatible = "vendor,ms7210"; reg = <0x2b>; status = "disabled"; };
	it66121: hdmi-tx@4c { compatible = "ite,it66121"; reg = <0x4c>; status = "disabled"; };
};

&i2c3 { status = "disabled"; };
&vop0 { status = "disabled"; };
&vop1 { status = "disabled"; };

/* ========================================================
 * 串口开启（对照实机 TTL 日志修正）
 * 日志证据：earlycon at MMIO 0x20064000（= uart2），8250 probe 0x10124000（= uart0）；
 * TTL 物理接在 uart2，故正式 console 用 &uart2（ttyS2）。
 * 原代码开启的是 &uart0；现改为 &uart2，uart0 保持 dtsi 默认 disabled。
 * ======================================================== */
/* 原始（误改）：&uart0 { status = "okay"; }; */
&uart2 {
	status = "okay";
};

&pinctrl {
	pmic { pmic_int: pmic-int { rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>; }; };
	hym8563 { rtc_int: rtc-int { rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>; }; };
	ir-receiver { ir_recv_pin: ir-recv-pin { rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>; }; };
};
