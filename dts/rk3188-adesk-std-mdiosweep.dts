	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		key-power {
			gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			label = "GPIO Key Power";
			linux,input-type = <1>;
			wakeup-source;
			debounce-interval = <100>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		led-blue {
			label = "adesk:blue:status";
			gpios = <&gpio0 RK_PB6 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		led-red {
			label = "adesk:red:power";
			gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	ir_recv: ir-receiver {
		compatible = "gpio-ir-receiver";
		gpios = <&gpio0 RK_PB2 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&ir_recv_pin>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "RK_ES8316";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,cpu { sound-dai = <&i2s0>; };
		simple-audio-card,codec { sound-dai = <&es8316>; };
	};
};

&cpu0 { cpu-supply = <&vdd_cpu>; };
&cpu1 { cpu-supply = <&vdd_cpu>; };
&cpu2 { cpu-supply = <&vdd_cpu>; };
&cpu3 { cpu-supply = <&vdd_cpu>; };

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	rk808: pmic@1b {
		compatible = "rockchip,rk808";
		reg = <0x1b>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		rockchip,system-power-controller;
		wakeup-source;
		#clock-cells = <1>;
		clock-output-names = "rk808-clkout1", "rk808-clkout2";

		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc6-supply = <&vcc_sys>;
		vcc7-supply = <&vcc_sys>;
		vcc8-supply = <&vcc_io>;
		vcc9-supply = <&vcc_io>;

		regulators {
			vdd_cpu: DCDC_REG1 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1100000>; regulator-max-microvolt = <1100000>; regulator-name = "vdd_arm"; };
			vdd_core: DCDC_REG2 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1100000>; regulator-max-microvolt = <1100000>; regulator-name = "vdd_core"; };
			vcc_ddr: DCDC_REG3 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; regulator-name = "vcc_ddr"; };
			vcc_io_rk: DCDC_REG4 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-name = "vcc_io"; };
			vcc_33: LDO_REG1 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-name = "vcc_33"; };
			vcc_18: LDO_REG2 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-name = "vcc_18"; };
			vcc_10: LDO_REG3 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1000000>; regulator-max-microvolt = <1000000>; regulator-name = "vcc_10"; };
			vcc_18_2: LDO_REG4 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-name = "vcc_18_2"; };
			vcc_28: LDO_REG5 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <2800000>; regulator-max-microvolt = <2800000>; regulator-name = "vcc_28"; };
			vcc_12: LDO_REG6 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; regulator-name = "vcc_12"; };
			vcc_18_3: LDO_REG7 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-name = "vcc_18_3"; };
			vcc_33_2: LDO_REG8 { regulator-always-on; regulator-boot-on; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-name = "vcc_33_2"; };
		};
	};

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB5 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&rtc_int>;
		#clock-cells = <0>;
		clock-output-names = "xin32k";
		wakeup-source;
	};
};

/* eMMC 控制器 */
&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clk>, <&emmc_cmd>, <&emmc_rst>;
	vmmc-supply = <&vcc_io>;
	status = "okay";
};

/* SD/TF 卡槽控制器
 *
 * 【第十轮改动：status okay → disabled】
 * 本机（aDesk-STD-200H-s 瘦客户机）主板上没有 SD/TF 卡槽，sd0 那组引脚
 * （sd0_clk/cmd/d0~d3/cd）没有引出到任何连接器。保持 okay 的代价是：
 *   1) 每次启动都注册一个不可能有卡的 host，做一次 400kHz 探测（ttl-rz9 里
 *      "mmc_host mmc0: Bus speed ... 400000Hz" 之后就没有下文，白跑一遍）；
 *   2) pinctrl 会把 sd0 那组脚按 SD 功能配置掉。若这块板子把其中某几根脚
 *      复用成了别的用途（瘦客户机常见做法），就是潜在冲突。
 * 所以直接关掉。原来的配置用注释保留，将来若要接 SD 卡或 SDIO WiFi，
 * 把 status 改回 "okay" 即可。
 *
 * 【为什么关掉它不会变成 mmcblk0】
 * mmc 控制器的编号不是按 probe 顺序，而是按 aliases：
 *   drivers/mmc/core/host.c（v6.12）：
 *     alias_id = of_alias_get_id(dev->of_node, "mmc");
 *     if (alias_id >= 0) index = alias_id;
 * 本 dts 的 aliases 里写了 mmc1 = &emmc，所以 eMMC 固定是 mmc1 →
 * /dev/mmcblk1，parameter.txt 的 root=/dev/mmcblk1p1 继续有效。
 * 千万不要把 mmc1 这条别名删掉或改成 mmc0（已本地核过 6.12 源码）。
 */
&mmc0 {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sd0_clk>, <&sd0_cmd>, <&sd0_cd>, <&sd0_bus4>;
	vmmc-supply = <&vcc_io>;
	// status = "okay";          // 原值（保留备查）
	status = "disabled";          // 本机无 SD/TF 卡槽，见上方说明
};

&emac {
	/* ---- 第二十二轮：属性名从 phy-handle 改成 phy（本轮唯一改动）----
	 * 原值（保留备查）：phy-handle = <&phy0>;
	 *
	 * 为什么必须改（6.12 源码，drivers/net/ethernet/arc/emac_main.c:869）：
	 *   phy_node = of_parse_phandle(dev->of_node, "phy", 0);
	 *   if (!phy_node) {
	 *           dev_err(dev, "failed to retrieve phy description from device tree");
	 *           return -ENODEV;
	 *   }
	 * 驱动找的是名为 "phy" 的 phandle，而 "phy-handle" 是 stmmac/其他驱动的写法。
	 * 属性名对不上 → 直接返回 -ENODEV(-19) → 网卡根本注册不上，
	 * 于是 /sys/class/net 里只有 lo 和 sit0（sit0 是 IPv6 隧道占位设备）。
	 * 实机日志完全对得上：
	 *   rockchip_emac 10204000.ethernet: failed to retrieve phy description from device tree
	 *   rockchip_emac 10204000.ethernet: failed to probe arc emac (-19)
	 *
	 * 另一个"看着像错、其实无害"的日志是 "no regulator found"，
	 * 出自 emac_rockchip.c:162 的 devm_regulator_get_optional()，可选，忽略即可。
	 *
	 * phy-mode 本来不用写（基节点 rk3xxx.dtsi:203 已有 phy-mode = "rmii"，
	 * 且 emac_rockchip.c:121 只接受 RMII，继承下来正好）；这里显式再写一遍，
	 * 是为了万一将来换基树/换版本时该属性丢失 —— 值与原继承值完全相同，
	 * 属于"写了不改行为"的保险，参考朋友那份 rk3188-adesk.dts:199。
	 */
	phy-mode = "rmii";

	/* 参考朋友那份 rk3188-adesk.dts:200 补上 PHY 供电引用。
	 * 原状（无此行）会打印 "rockchip_emac 10204000.ethernet: no regulator found"，
	 * 该告警来自 emac_rockchip.c:162 的 devm_regulator_get_optional(dev, "phy")，
	 * 本身不致命；补上后这行噪音消失，并把 3.3V IO 电源正式挂到 PHY 上。
	 * vcc_io 在本 dts 里是 regulator-fixed、regulator-always-on，enable 是空操作，无风险。
	 */
	phy-supply = <&vcc_io>;

	phy = <&phy0>;          /* 关键：驱动要的是 phy，不是 phy-handle，见上方说明 */
	pinctrl-names = "default";
	/* 原值（保留备查）：pinctrl-0 = <&emac_xfer>, <&emac_mdio>;
	 * GPIOD0/D1 已被 mdio-gpio 当 GPIO 用掉了，这里不能再申请为 EMAC 复用功能，
	 * 否则 pinctrl 会把同一只脚配成两种功能，后者覆盖前者。 */
	pinctrl-0 = <&emac_xfer>;
	status = "okay";

	/* 原值（保留备查）：内部 mdio 子节点，phy0 在这里
	 *   mdio {
	 *           #address-cells = <1>;
	 *           #size-cells = <0>;
	 *           phy0: ethernet-phy@0 { reg = <0>; };
	 *   };
	 * 现在 phy0 移到 root 下的 mdio_gpio 总线里，硬件 MDIO 总线上不再挂 PHY，
	 * 但驱动仍会注册这条空总线（arc_mdio_probe 在没有 mdio 子节点时
	 * 用 emac 节点本身注册），不影响功能。 */
};

&usbphy { status = "okay"; };
&usb_host { status = "okay"; };
&usb_otg { status = "okay"; };

&i2c4 {
	status = "okay";
	clock-frequency = <100000>;
	es8316: codec@10 {
		compatible = "everest,es8316";
		reg = <0x10>;
		clocks = <&cru SCLK_I2S0>;
		clock-names = "mclk";
		#sound-dai-cells = <0>;
	};
};

&i2s0 { status = "okay"; };

&i2c0 {
	status = "okay";
	vga_edid: eeprom@50 { compatible = "atmel,24c02"; reg = <0x50>; pagesize = <16>; };
};

&i2c2 {
	status = "okay";
	hdmi_tx: hdmi@2b { compatible = "vendor,ms7210"; reg = <0x2b>; status = "disabled"; };
	it66121: hdmi-tx@4c { compatible = "ite,it66121"; reg = <0x4c>; status = "disabled"; };
};

&i2c3 { status = "disabled"; };
&vop0 { status = "disabled"; };
&vop1 { status = "disabled"; };

/* ========================================================
 * 串口开启（对照实机 TTL 日志修正）
 * 日志证据：earlycon at MMIO 0x20064000（= uart2），8250 probe 0x10124000（= uart0）；
 * TTL 物理接在 uart2，故正式 console 用 &uart2（ttyS2）。
 * 原代码开启的是 &uart0；现改为 &uart2，uart0 保持 dtsi 默认 disabled。
 * ======================================================== */
/* 原始（误改）：&uart0 { status = "okay"; }; */
&uart2 {
	status = "okay";
};

&pinctrl {
	/* ----------------------------------------------------------------
	 * 【第二十四轮修正：group 必须挂在"函数节点"下面，不能直接放顶层】
	 *
	 * 上一版把 emac_mdio_gpio 直接写成 &pinctrl 的子节点，实机日志报：
	 *   rockchip-pinctrl pinctrl: unable to find group for node emac-mdio-gpio
	 * 原因在 pinctrl-rockchip.c 的 rockchip_pinctrl_parse_functions()：
	 *   func->ngroups = of_get_child_count(np);
	 *   if (func->ngroups <= 0) return 0;     ← 没有子节点就整个跳过
	 * 也就是说 pinctrl 顶层每个子节点被当成"一个函数"，它的**子节点**才是
	 * 真正的 group。group 直接放顶层 → 既不注册 group，也查不到这个 phandle，
	 * 于是 mdio-gpio 节点 pinctrl-0 应用失败、驱动没 probe，PHY 根本没注册，
	 * emac 拿着 phy0 去找人自然 of_phy_connect() failed (-19)。
	 *
	 * 这里把 group 挪进 dtsi 里本来就有的 emac 函数节点（DT 同名节点自动合并），
	 * 和上面 pmic / hym8563 / ir-receiver 的写法保持一致。
	 * ---------------------------------------------------------------- */
	emac {
		/* D1 = MDC 只输出，不配上下拉；D0 = MDIO 双向，配上拉
		 * （双向开漏线配上拉，与板上外部上拉并联不会出问题） */
		emac_mdio_gpio: emac-mdio-gpio {
			rockchip,pins = <3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>,
			                <3 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	pmic { pmic_int: pmic-int { rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>; }; };
	hym8563 { rtc_int: rtc-int { rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>; }; };
	ir-receiver { ir_recv_pin: ir-recv-pin { rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>; }; };
};
