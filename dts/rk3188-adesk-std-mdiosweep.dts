// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/dts-v1/;
/*
 * 【诊断专用】MDIO 引脚扫频版（不是最终版）
 * 背景：RTL8201FN 在 GPIO3_D0/D1 上，硬件 MDIO（ttl-17）和软件 bit-bang（ttl-19）
 * 都扫不到 0~7 任一地址；而 RJ45 指示灯亮，说明 PHY 有电、链路正常。
 * 做法：在 GPIO3 组（pin 96~127 = A0~D7）内，把所有【相邻引脚对】的正反两种极性
 * 各挂一条 mdio-gpio 总线（共 62 条），每条都扫 0~7 号地址。
 * 判读：哪一条总线打出“不是 missing”的地址，那两只脚就是真的 MDC/MDIO，
 * 且那个地址就是 PHY 真实地址。找到后改回单总线正式版。
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3188.dtsi"

/ {
	model = "aDesk-STD-200H-s RK3188 TV Box (MDIO pin sweep)";
	compatible = "rockchip,rk3188";

	aliases {
		/* 物理 TTL 接 UART2（0x20064000）；uart2 由 dtsi 默认 alias serial2 映射为 ttyS2 */
		serial0 = &uart0;
		serial2 = &uart2;
		/* mdio-gpio 总线别名：驱动靠它取 bus id（of_alias_get_id(node,"mdio-gpio")），
		 * 没有这行只会打印一句 failed to get alias id 然后 id=0，功能不受影响 */
		mdio-gpio0 = &mdio_gpio0;
		mdio-gpio1 = &mdio_gpio1;
		mdio-gpio2 = &mdio_gpio2;
		mdio-gpio3 = &mdio_gpio3;
		mdio-gpio4 = &mdio_gpio4;
		mdio-gpio5 = &mdio_gpio5;
		mdio-gpio6 = &mdio_gpio6;
		mdio-gpio7 = &mdio_gpio7;
		mdio-gpio8 = &mdio_gpio8;
		mdio-gpio9 = &mdio_gpio9;
		mdio-gpio10 = &mdio_gpio10;
		mdio-gpio11 = &mdio_gpio11;
		mdio-gpio12 = &mdio_gpio12;
		mdio-gpio13 = &mdio_gpio13;
		mdio-gpio14 = &mdio_gpio14;
		mdio-gpio15 = &mdio_gpio15;
		mdio-gpio16 = &mdio_gpio16;
		mdio-gpio17 = &mdio_gpio17;
		mdio-gpio18 = &mdio_gpio18;
		mdio-gpio19 = &mdio_gpio19;
		mdio-gpio20 = &mdio_gpio20;
		mdio-gpio21 = &mdio_gpio21;
		mdio-gpio22 = &mdio_gpio22;
		mdio-gpio23 = &mdio_gpio23;
		mdio-gpio24 = &mdio_gpio24;
		mdio-gpio25 = &mdio_gpio25;
		mdio-gpio26 = &mdio_gpio26;
		mdio-gpio27 = &mdio_gpio27;
		mdio-gpio28 = &mdio_gpio28;
		mdio-gpio29 = &mdio_gpio29;
		mdio-gpio30 = &mdio_gpio30;
		mdio-gpio31 = &mdio_gpio31;
		mdio-gpio32 = &mdio_gpio32;
		mdio-gpio33 = &mdio_gpio33;
		mdio-gpio34 = &mdio_gpio34;
		mdio-gpio35 = &mdio_gpio35;
		mdio-gpio36 = &mdio_gpio36;
		mdio-gpio37 = &mdio_gpio37;
		mdio-gpio38 = &mdio_gpio38;
		mdio-gpio39 = &mdio_gpio39;
		mdio-gpio40 = &mdio_gpio40;
		mdio-gpio41 = &mdio_gpio41;
		mdio-gpio42 = &mdio_gpio42;
		mdio-gpio43 = &mdio_gpio43;
		mdio-gpio44 = &mdio_gpio44;
		mdio-gpio45 = &mdio_gpio45;
		mdio-gpio46 = &mdio_gpio46;
		mdio-gpio47 = &mdio_gpio47;
		mdio-gpio48 = &mdio_gpio48;
		mdio-gpio49 = &mdio_gpio49;
		mdio-gpio50 = &mdio_gpio50;
		mdio-gpio51 = &mdio_gpio51;
		mdio-gpio52 = &mdio_gpio52;
		mdio-gpio53 = &mdio_gpio53;
		mdio-gpio54 = &mdio_gpio54;
		mdio-gpio55 = &mdio_gpio55;
		mdio-gpio56 = &mdio_gpio56;
		mdio-gpio57 = &mdio_gpio57;
		mdio-gpio58 = &mdio_gpio58;
		mdio-gpio59 = &mdio_gpio59;
		mdio-gpio60 = &mdio_gpio60;
		mdio-gpio61 = &mdio_gpio61;
		mmc0 = &mmc0;   /* SD 卡控制器（本机无卡槽，节点已 disabled，别名保留仅占位） */
		mmc1 = &emmc;   /* eMMC 控制器：这条别名决定它固定是 mmc1 → /dev/mmcblk1，
		                   必须保留，否则 root=/dev/mmcblk1p1 会失效 */
	};

	chosen {
		/* 修正：console/stdout 对齐物理串口 UART2（ttyS2）；原 serial0/uart0 是误改
		 *
		 * 【第五轮 DTS 改动 2/2：bootargs 与 parameter.txt 的 CMDLINE 完全对齐】
		 * 原代码：
		 *   bootargs = "console=ttyS2,115200 earlyprintk loglevel=8";
		 * 只带 console，没有 root= / blkdevparts。
		 *
		 * 为什么要在 DT 里也写一份？
		 *   内核配置里有 CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y，
		 *   正常路径是 loader 把 parameter.txt 的 CMDLINE 通过 ATAG 传进来并覆盖
		 *   这里的 bootargs（所以上一轮日志里的 CMDLINE 一直等于 parameter 内容）。
		 *   但一旦 loader 没传 ATAG（换 loader / 换刷机模式 / parameter 没被选中），
		 *   内核就会退回到吃这里的 bootargs —— 没有 root= 和 blkdevparts 时
		 *   又必然 panic。这里写同一份完整串，等于给内核留一条备用路径。
		 *   两处内容必须一字不差地保持同步（build.yml 已从 parameter.txt 里读取
		 *   CMDLINE 直接写进 boot.img 头，CI 还会比对，防止两边漂移）。
		 *
		 * blkdevparts=mmcblk1:-@24M(rootfs)：
		 *   eMMC 上没有 MBR/GPT（ttl-rz4 的 unknown-block(179,1) 已证明），
		 *   由内核 block/partitions/cmdline.c 按命令行建分区：
		 *   在 mmcblk1 上、从 24MiB 起、到盘尾，建 1 个名为 rootfs 的分区，
		 *   即 /dev/mmcblk1p1。生效前提是 CONFIG_PARTITION_ADVANCED=y +
		 *   CONFIG_CMDLINE_PARTITION=y（build.yml 编译期已强制校验）。
		 *   注意 "-" 是“剩余全部”，单位字节。
		 *
		 *   【4MiB 这个数字的来历（对照教程日志）】
		 *   教程 TTL 里有：
		 *     mmcblk0boot0: mmc0:0001 Biwin 4.00 MiB
		 *     mmcblk0boot1: mmc0:0001 Biwin 4.00 MiB
		 *   这是 eMMC 的两个**硬件 boot 分区**的尺寸（那片 Biwin 是 4MiB，本机
		 *   的 004GA1 是 2MiB），与 rootfs 偏移无关，不用管。
		 *   真正与偏移有关的是 parameter 里的 0x2000：扇区单位 ×512 = 4MiB，
		 *   这是加载器/parameter 自身的保留区（loader 就写在扇区 0 起），
		 *   所以 boot 从 4MiB 开始、长 16MiB，到 20MiB(0xA000) 结束。
		 *   教程的 rootfs 正是紧接其后 @0xA000 —— 首尾相接，中间没有空洞。
		 *
		 *   【第八/九轮踩过的坑】
		 *   ttl-rz8：rootfs 声明 0xA000，救援 init 逐偏移读 ext4 超级块，只有
		 *   24MiB（25165824）命中（卷标 rootfs），20MiB 处是残留的 "ANDROID!" 头。
		 *   ttl-rz9：把声明挪到 0xC000 后，数据又跑到 28MiB；而 24MiB 那份变成
		 *   "超级块还在、日志区被覆盖"的废拷贝，挂载报：
		 *     JBD2: no valid journal superblock found
		 *     EXT4-fs (mmcblk1p1): Could not load journal inode
		 *   两轮实测的规律是固定 +4MiB：工具写盘位置 = 声明偏移 + 0x2000 扇区。
		 *   既然规律是死的，就把声明挪回教程同款的 0xA000，让数据落回 24MiB。
		 *
		 *   【第十轮：实现存储对齐】
		 *       boot    0x2000 .. 0xA000（4MiB~20MiB，容量 16MiB）
		 *       rootfs  声明 0xA000(20MiB) → 工具 +4MiB → 数据落 24MiB
		 *       内核    @24M            → p1 起点 = 24MiB = 数据起点
		 *   三处数字固定成 20MiB/24MiB 这组关系：声明→实际→内核视图一条线，
		 *   24MiB 是 4MiB 整数倍（对 eMMC 擦除块/页对齐友好），
		 *   且 24MiB 是**唯一被实机成功挂载过**的偏移（ttl-rz8：losetup -o
		 *   25165824 + mount 成功，df 报 973.4M 总/288.8M 已用）。
		 *   原值（第九轮，保留备查）：blkdevparts=mmcblk1:-@28M(rootfs)
		 *          + mtdparts ...-@0x0000C000(rootfs)
		 */
		stdout-path = "serial2:115200n8";
		// 【第七轮改动：bootargs 补 initrd=0x62000000,0x00800000，与 parameter.txt 的 CMDLINE 逐字对齐】
		// 原因：ttl-rz7 里 boot.img 头带了 ramdisk（头校验 ramdisk_addr=0x62000000、
		// ramdisk_size>0），但内核完全没有 unpack initramfs 的动作，直接进 mount_root
		// 然后 panic —— 说明 loader 没把 ramdisk 交给内核。原厂 parameter-bibl.txt 的
		// CMDLINE 里正是有 initrd=0x62000000,0x00800000，它是 RK31 loader "把 ramdisk
		// 搬到 0x62000000" 的指令。loader 会用自己的 CMDLINE 覆盖这里（ATAG_FROM_
		// BOOTLOADER），所以两边必须同步；平时以 parameter.txt 为准。
		// 原值（保留备查；第七轮时的形态：无 initrd=，rootfs 起点 20M = 0xA000）：
		// bootargs = "console=ttyS2,115200 earlyprintk root=/dev/mmcblk1p1 rootfstype=ext4 rw rootwait init=/sbin/init maxcpus=1 blkdevparts=mmcblk1:-@20M(rootfs)";
		// 原值（第九轮，保留备查）：blkdevparts=mmcblk1:-@28M(rootfs)（本轮回到 @24M，见上方注释）
		// 原值（第十轮，保留备查）：... init=/sbin/init initrd=0x62000000,0x00800000 maxcpus=1 ...
		// 【ttl-rz10 改动：去掉 initrd=0x62000000,0x00800000】
		// 主刷的 boot.img 是纯内核（没有 ramdisk），但 CMDLINE 里带 initrd= 会让
		// loader 在 0x62000000 上交给内核一段 192K 残留垃圾，内核就去"解 initramfs"
		// → "junk within compressed archive" 失败 → 跳过挂根 → exec /init(ENOENT)
		// → exec /sbin/init(ENOENT) → panic（ttl-rz10 实测）。
		// 去掉后内核对 initramfs 不再有期待，会正常执行挂根流程。
		// 只有刷 boot-rescue.img（带救援 initramfs）时才需要它，那份走
		// parameter-rescue.txt，不改这里（这里的 bootargs 是 loader 不传 ATAG 时的兜底）。
		bootargs = "console=ttyS2,115200 earlyprintk root=/dev/mmcblk1p1 rootfstype=ext4 rw rootwait init=/sbin/init maxcpus=1 blkdevparts=mmcblk1:-@24M(rootfs)";
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x40000000>; /* 1GB DDR3 */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		ion1: ion@88400000 { reg = <0x88400000 0x06400000>; no-map; };
		ion2: ion@7ee00000 { reg = <0x7ee00000 0x09600000>; no-map; };
		fb: framebuffer@7a600000 { reg = <0x7a600000 0x04800000>; no-map; };
	};

	vcc_sys: vsys-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vsys";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
	};

	vcc_io: vcc-io-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/* ============================================================
	 * 第二十三轮：MDIO 改成 GPIO 软件模拟总线（bit-bang）
	 * ============================================================
	 * 依据一（原厂固件）：从原机 kernel.img 里提取到的字符串是
	 *   mdio_bb_read / mdio_bb_write              → 原厂就是软件 bit-bang
	 *   "request mdio pin ok" / "request mdc pin ok" → 把两只脚当 GPIO 申请
	 *   "output mdio ctl pin ok , enable rtl8201f ethernet function"
	 * 依据二（实机）：ttl-16/ttl-17 用 SoC 硬件 MDIO 读 RTL8201FN，0~7 号地址
	 * 全部 missing，每次超时约 33ms（读到的是上拉电平 0xffff）；而 RJ45 指示灯是亮的，
	 * 说明 PHY 有电、链路正常，只是管理口这条通路没通。
	 *
	 * 做法：GPIO3_D0/D1 从 EMAC 复用功能改成 GPIO，交给内核 mdio-gpio 驱动
	 * 用软件时序扫描；速率由软件决定，远低于 RTL8201FN 的 MDC 上限 2.5MHz。
	 * 同时把 0~7 全部地址都声明出来：一次启动既验证通路，又直接定位 PHY 地址。
	 */
	/* [00] MDC=GPIO3_D1(121)  MDIO=GPIO3_D0(120) */
	mdio_gpio0: mdio-gpio-0 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 25 GPIO_ACTIVE_HIGH>,
		        <&gpio3 24 GPIO_ACTIVE_HIGH>;
		/* 只给第 0 条（D1/D0，与 ttl-19 完全同条件）配上拉，保证可复现对照 */
		pinctrl-names = "default";
		pinctrl-0 = <&emac_mdio_gpio>;
		phy0: ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [01] MDC=GPIO3_A0(96)  MDIO=GPIO3_A1(97) */
	mdio_gpio1: mdio-gpio-1 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 0 GPIO_ACTIVE_HIGH>,
		        <&gpio3 1 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [02] MDC=GPIO3_A1(97)  MDIO=GPIO3_A0(96) */
	mdio_gpio2: mdio-gpio-2 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 1 GPIO_ACTIVE_HIGH>,
		        <&gpio3 0 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [03] MDC=GPIO3_A1(97)  MDIO=GPIO3_A2(98) */
	mdio_gpio3: mdio-gpio-3 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 1 GPIO_ACTIVE_HIGH>,
		        <&gpio3 2 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [04] MDC=GPIO3_A2(98)  MDIO=GPIO3_A1(97) */
	mdio_gpio4: mdio-gpio-4 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 2 GPIO_ACTIVE_HIGH>,
		        <&gpio3 1 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [05] MDC=GPIO3_A2(98)  MDIO=GPIO3_A3(99) */
	mdio_gpio5: mdio-gpio-5 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 2 GPIO_ACTIVE_HIGH>,
		        <&gpio3 3 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [06] MDC=GPIO3_A3(99)  MDIO=GPIO3_A2(98) */
	mdio_gpio6: mdio-gpio-6 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 3 GPIO_ACTIVE_HIGH>,
		        <&gpio3 2 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [07] MDC=GPIO3_A3(99)  MDIO=GPIO3_A4(100) */
	mdio_gpio7: mdio-gpio-7 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 3 GPIO_ACTIVE_HIGH>,
		        <&gpio3 4 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [08] MDC=GPIO3_A4(100)  MDIO=GPIO3_A3(99) */
	mdio_gpio8: mdio-gpio-8 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 4 GPIO_ACTIVE_HIGH>,
		        <&gpio3 3 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [09] MDC=GPIO3_A4(100)  MDIO=GPIO3_A5(101) */
	mdio_gpio9: mdio-gpio-9 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 4 GPIO_ACTIVE_HIGH>,
		        <&gpio3 5 GPIO_ACTIVE_HIGH>;
		ethernet-phy@0 { reg = <0>; };
		ethernet-phy@1 { reg = <1>; };
		ethernet-phy@2 { reg = <2>; };
		ethernet-phy@3 { reg = <3>; };
		ethernet-phy@4 { reg = <4>; };
		ethernet-phy@5 { reg = <5>; };
		ethernet-phy@6 { reg = <6>; };
		ethernet-phy@7 { reg = <7>; };
	};

	/* [10] MDC=GPIO3_A5(101)  MDIO=GPIO3_A4(100) */
	mdio_gpio10: mdio-gpio-10 {
		compatible = "virtual,mdio-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios = <&gpio3 5 GPIO_ACTIVE_HIGH>,
		        <&gpio3 4 GPIO_ACTIVE_HIGH>;
